# Only needed for the side-by-side demo app. Connecting your own agent through
# Aura's hosted MCP server needs no .env file.

# Neo4j Aura Free: https://console.neo4j.io (no credit card).
# When you create an instance, Aura gives you a credentials file; paste its values here.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# Claude API key: https://platform.claude.com
ANTHROPIC_API_KEY=
